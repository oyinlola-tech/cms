PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=mysql
DB_NAME=church_db

# Auth
# Generate a long random value (32+ chars). Never use the default in production.
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Bootstrap super_admin account, created by db-init.js on first run only.
# Must be at least 10 characters; production startup fails on a weak value.
# Additional users are created from Admin -> Users once you can sign in.
ADMIN_NAME=Parish Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Allowed browser origins, comma-separated. REQUIRED in production - startup
# fails if this is empty when NODE_ENV=production, because an empty list means
# "reflect any origin".
# Example: CORS_ORIGIN=https://cms.yourchurch.org
CORS_ORIGIN=

# Number of reverse-proxy hops in front of the app (nginx, a load balancer...).
# Leave at 0 when the app is exposed directly: trusting X-Forwarded-For when
# nothing strips it lets clients spoof their IP and evade rate limiting.
TRUST_PROXY_HOPS=0

# SMTP. Outside production, OTP codes are printed to the server console
# instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sacred Hearth CMS" <noreply@example.com>

